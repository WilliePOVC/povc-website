# Notion API key for the Press page (server-side only)
# Get from https://www.notion.so/my-integrations
# Must have access to the "Connect" table (DB ID: 36ce9175-4432-81b1-88fd-e9d46f533b94)
NOTION_API_KEY=secret…xxxx

# ── Podcast hub (/podcast) — read at BUILD time (static export) ──
# Set these as GitHub Actions repository secrets/variables, not in the browser.
# Without YOUTUBE_API_KEY the build uses the channel's public RSS feed (latest 15, no durations).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCBZ2His5V_nTxXtBc4cxeUA
# Optional: a playlist containing ONLY podcast episodes (recommended once there are clips/Shorts)
YOUTUBE_PLAYLIST_ID=
